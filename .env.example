# =============================================================================
# GESTOR LANDINGS - Configuración de Entorno
# =============================================================================

# Servidor
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# JWT - Obligatorio
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiame-por-una-clave-segura

# Base de datos (PostgreSQL)
# Local: postgresql://user:password@localhost:5432/landings?schema=public
# Docker: postgresql://landings:landings@db:5432/landings?schema=public
DATABASE_URL=postgresql://landings:landings@localhost:5432/landings?schema=public

# Email (SMTP) - Opcional, sin esto las notificaciones se loguean en consola
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_USER=tu@email.com
SMTP_PASS=tucontraseña
SMTP_FROM=noreply@tudominio.com

# FTP Encryption (opcional, usa JWT_SECRET si no se define)
# FTP_ENCRYPTION_KEY=clave-para-cifrar-ftp

# OAuth Google (opcional)
# GOOGLE_CLIENT_ID=tu-client-id-de-google

# Logging (debug | info | warn | error)
LOG_LEVEL=debug