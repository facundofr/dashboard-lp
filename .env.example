# =============================================================================
# GESTOR LANDINGS - Configuración de Entorno
# =============================================================================

# Servidor
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# JWT - Obligatorio
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiame-por-una-clave-segura

# Base de datos
# Provider: "sqlite" para local, "postgresql" para producción
DATABASE_PROVIDER=sqlite
# SQLite (local): file:./dev.db
# PostgreSQL (producción): postgresql://landings:landings@localhost:5432/landings?schema=public
DATABASE_URL=file:./dev.db

# Email (SMTP) - Opcional, sin esto las notificaciones se loguean en consola
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_USER=tu@email.com
SMTP_PASS=tucontraseña
SMTP_FROM=noreply@tudominio.com

# FTP Encryption - Recomendado, debe ser distinta a JWT_SECRET
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FTP_ENCRYPTION_KEY=cambiame-por-una-clave-segura-para-ftp

# OAuth Google (opcional)
# GOOGLE_CLIENT_ID=tu-client-id-de-google

# Logging (debug | info | warn | error)
LOG_LEVEL=debug