generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int       @id @default(autoincrement())
  email                 String    @unique
  password              String
  nombre                String
  role                  String    @default("user")
  plan                  String    @default("free")
  notifyEmail           Boolean   @default(true)
  sendSslAlerts         Boolean   @default(true)
  avatarUrl             String?
  emailVerified         Boolean   @default(false)
  emailVerificationToken String?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  refreshTokenHash      String?
  disabled              Boolean   @default(false)
  approved              Boolean   @default(true)
  provider              String?
  providerId            String?
  createdAt             DateTime  @default(now())

  landings              Landing[]
  webhookConfigs        WebhookConfig[]
  auditLogs             AuditLog[]
  statusPage            StatusPage?
  notifications         Notification[]
}

model WebhookConfig {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  events    String   @default("down,ssl_expiring")
  enabled   Boolean  @default(true)
  secret    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TemplateType {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  icon          String   @default("📄")
  description   String?
  hasMonitoring Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fieldDefinitions FieldDefinition[]
  landings         Landing[]
}

model FieldDefinition {
  id              Int      @id @default(autoincrement())
  templateTypeId  Int
  templateType    TemplateType @relation(fields: [templateTypeId], references: [id], onDelete: Cascade)
  name            String
  label           String
  fieldType       String   @default("text")
  required        Boolean  @default(false)
  sortOrder       Int      @default(0)
  placeholder     String?
  options         String?
  defaultVisible  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([templateTypeId, name])
}

model Landing {
  id        Int      @id @default(autoincrement())
  nombre    String
  marca     String
  url       String
  estado    String   @default("ACTIVO")
  categoria String   @default("Cober")

  templateTypeId Int?
  templateType   TemplateType? @relation(fields: [templateTypeId], references: [id], onDelete: SetNull)
  dynamicValues  String?
  visibleFields  String?

  ftpHost   String?
  ftpUser   String?
  ftpPass   String?
  ftpPath   String?

  tecnologias String?
  notas       String?
  imagenUrl   String?
  sheetUrl    String?
  formStatus  String   @default("PENDIENTE")
  tags        String?
  cliente     String?
  metaTags    String?

  ultimoDeploy DateTime?

  ultimoCheck     DateTime?
  ultimoStatus    String?
  ultimoCodigo    Int?
  ultimoMs        Int?
  ultimoSslValido Boolean?
  ultimoSslDias   Int?
  ultimoSslVence  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  logs      CheckLog[]
  audits    AuditLog[]
  incidents Incident[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  landingId Int?
  action    String
  details   String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  landing Landing? @relation(fields: [landingId], references: [id], onDelete: SetNull)
}

model CheckLog {
  id          Int      @id @default(autoincrement())
  landingId   Int
  statusCode  Int?
  responseMs  Int?
  isUp        Boolean
  error       String?
  createdAt   DateTime @default(now())
  landing     Landing  @relation(fields: [landingId], references: [id], onDelete: Cascade)
}

model Incident {
  id              Int       @id @default(autoincrement())
  landingId       Int
  landing         Landing   @relation(fields: [landingId], references: [id], onDelete: Cascade)
  startedAt       DateTime  @default(now())
  recoveredAt     DateTime?
  duration        Int?
  acknowledgedAt  DateTime?
  createdAt       DateTime  @default(now())
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String   @default("info")
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   @default("from-purple-600/80 to-pink-600/80")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StatusPage {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String   @unique
  title     String   @default("Estado del Servicio")
  subtitle  String?
  logoUrl   String?
  brandColor String  @default("#7c3aed")
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}